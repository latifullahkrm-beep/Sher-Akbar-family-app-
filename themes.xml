<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SherAkbar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/forest_green</item>
        <item name="android:navigationBarColor">@color/off_white</item>
    </style>

    <style name="Theme.SherAkbar.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/forest_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_sher_akbar_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.SherAkbar</item>
    </style>
</resources>
